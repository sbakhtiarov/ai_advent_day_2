AGENT_PUBLIC_PORT=8080
AGENT_IMAGE=kotlin-agent-cli-agent-api:latest

AGENT_API_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=sk-your-key
AGENT_API_MODEL=gpt-5.2-codex
AGENT_API_TEMPERATURE=0.2

# Full stack mode:
# - set WIRE_RAG_IMAGE to your actual Wire App RAG image
# - run: docker compose --profile rag up --build -d
WIRE_RAG_IMAGE=ghcr.io/replace-me/wire-app-rag:latest
WIRE_RAG_PORT=8000

# Agent-only mode with external RAG:
# - set this to your existing RAG URL
# - run: docker compose up --build -d
WIRE_APP_RAG_BASE_URL=http://wire-rag:8000

OPENAI_API_LOG_FILE=/var/log/kotlin-agent-cli/openai-api.log
